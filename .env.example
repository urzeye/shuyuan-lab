# Agent HTTP service
AGENT_PORT=3001
XBS_AGENT_HEADLESS=false
# Optional: chrome (default, then Chromium fallback) or chromium
XBS_AGENT_BROWSER_CHANNEL=

# Anthropic API credentials (required for AI generation)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Agent reasoning effort: high or max
ANTHROPIC_REASONING_EFFORT=high

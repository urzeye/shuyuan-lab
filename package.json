{
  "name": "shuyuan-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:agent\" \"pnpm dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:agent": "tsx server/index.ts",
    "build": "vue-tsc && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "skill:validate": "node scripts/validate-skill.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.211",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "marked": "^18.0.3",
    "pinia": "^2.1.7",
    "playwright": "^1.61.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.16"
  }
}
